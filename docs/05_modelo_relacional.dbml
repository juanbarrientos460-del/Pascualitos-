// Modelo relacional físico alineado con sql/01_crear_esquema.sql
Table maquina {
  id_maquina int [pk, increment]
  nombre varchar(20) [not null, unique]
}

Table turno {
  id_turno int [pk, increment]
  descripcion varchar(40) [not null, unique]
  hora_inicio time
  hora_fin time
}

Table persona {
  id_persona int [pk, increment]
  codigo_anonimo varchar(10) [not null, unique]
  rol varchar(20) [not null, note: 'OPERARIO o MANTENIMIENTO']
  indexes {
    (id_persona, rol) [unique]
  }
}

Table referencia {
  id_referencia int [pk, increment]
  producto varchar(80) [not null]
  volumen_cc int
  num_colores int
  indexes {
    (producto, volumen_cc, num_colores) [unique]
  }
}

Table codigo_paro {
  num_codigo int [pk]
  descripcion varchar(150) [not null]
}

Table subcodigo {
  id_subcodigo int [pk, increment]
  num_codigo int [not null]
  codigo_texto varchar(10) [not null]
  descripcion varchar(150) [not null]
  padre_id int
  indexes {
    (num_codigo, codigo_texto) [unique]
    (num_codigo, id_subcodigo) [unique]
  }
}

Table registro_produccion {
  id_registro bigint [pk, increment]
  fecha date [not null]
  id_maquina int [not null]
  id_turno int
  id_referencia int
  pacas_producidas int
  horas_trabajadas decimal(6,2)
  meta_por_hora decimal(10,2)
  observacion_paro text
  observaciones text
}

Table registro_persona {
  id_registro bigint [not null]
  id_persona int [not null]
  indexes {
    (id_registro, id_persona) [pk]
  }
}

Table paro {
  id_paro bigint [pk, increment]
  id_registro bigint [not null]
  num_codigo int [not null]
  minutos int [not null]
  id_subcodigo int
  ejecutor_tipo varchar(20)
  id_persona_involucrada int
  observacion text
}

Ref: registro_produccion.id_maquina > maquina.id_maquina [delete: restrict, update: cascade]
Ref: registro_produccion.id_turno > turno.id_turno [delete: restrict, update: cascade]
Ref: registro_produccion.id_referencia > referencia.id_referencia [delete: restrict, update: cascade]
Ref: subcodigo.num_codigo > codigo_paro.num_codigo [delete: restrict, update: cascade]
Ref: subcodigo.(num_codigo, padre_id) > subcodigo.(num_codigo, id_subcodigo) [delete: restrict, update: cascade]
Ref: registro_persona.id_registro > registro_produccion.id_registro [delete: cascade, update: cascade]
Ref: registro_persona.id_persona > persona.id_persona [delete: restrict, update: cascade]
Ref: paro.id_registro > registro_produccion.id_registro [delete: cascade, update: cascade]
Ref: paro.num_codigo > codigo_paro.num_codigo [delete: restrict, update: cascade]
Ref: paro.(num_codigo, id_subcodigo) > subcodigo.(num_codigo, id_subcodigo) [delete: restrict, update: cascade]
Ref: paro.(id_persona_involucrada, ejecutor_tipo) > persona.(id_persona, rol) [delete: restrict, update: cascade]
